{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiReviewResponse",
  "type": "object",
  "required": ["summary", "observations"],
  "properties": {
    "summary": { "type": "string" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "explanation", "recommendation"],
        "properties": {
          "code": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "explanation": { "type": "string" },
          "recommendation": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
